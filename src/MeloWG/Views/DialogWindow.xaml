<Window x:Class="MeloWG.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg1}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="22,20,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph" Style="{StaticResource T.Icon}" Text="&#xE946;" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock x:Name="MessageText" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="InputPanel" Grid.Row="1" Margin="70,14,22,0" Visibility="Collapsed">
                <TextBox x:Name="InputBox" Style="{StaticResource Input}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,22,22,20">
                <Button x:Name="SecondaryButton" Style="{StaticResource Btn.Secondary}" MinWidth="96" Click="Secondary_Click" IsCancel="True" />
                <Button x:Name="PrimaryButton" Style="{StaticResource Btn.Primary}" MinWidth="96" Margin="10,0,0,0" Click="Primary_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
